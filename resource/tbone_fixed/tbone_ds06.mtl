# wavefront mtl file for tbone
# Enhanced for realistic bone appearance

newmtl bone_material
Ka 0.35 0.33 0.30        # Ambient: Warm bone color in shadow
Kd 0.95 0.92 0.85        # Diffuse: Off-white/ivory bone color
Ks 0.3 0.3 0.3           # Specular: Moderate shine for bone surface
Ns 20.0                  # Specular exponent: Low-medium shininess for bone
d 1.0                    # Opacity: Fully opaque
Tr 0                     # Transparency: None (inverse of d)
illum 2                  # Illumination: Color, ambient, diffuse, and specular
